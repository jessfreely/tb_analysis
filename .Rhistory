library(tidyverse)
library(tibble)
library(tidyr)
library(dbplyr)
raw_tb_data <- read_csv("tb_analysis.csv")
#Inspect and column names
#glimpse(raw_tb_data)
#View first 10 rows
#head(raw_tb_data)
clean_tb_data <- raw_tb_data %>%
#Remove 'Notes' column
select(-Notes) %>%
#Remove columns that are completely empty
select(where(~any(!is.na(.)))) %>%
rename(
incidence_rate = 'Rate per 100',
state_population ='000',
pct_of_total_us_cases = 'Percent of Total'
)
#glimpse(clean_tb_data)
national_trends <- clean_tb_data %>%
group_by('Year') %>%
summarize(
total_cases = sum(Cases, na.rm = TRUE),
national_rate = (total_cases / sum(state_population, na.rm = TRUE)) * 100000
)
print(national_trends)
View(national_trends)
